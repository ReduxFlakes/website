{
  "name": "website",
  "description": "My personal site",
  "private": "true",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/reduxflakes/website.git"
  },
  "scripts": {
    "clean": "rm -rf ./_site",
    "start": "npm run clean && eleventy --serve --watch",
    "start:fast": "npm run clean && eleventy --serve --watch --incremental",
    "start:nekoweb": "npm run clean && HOST_TYPE=nekoweb eleventy --serve",
    "start:all": "npm run clean && BUILD_TYPE=production HOST_TYPE=all eleventy --serve",
    "html-minify": "html-minifier-terser --config-file=.html-minifier.json --input-dir=_site --output-dir=_site --file-ext=html",
    "build": "npm run clean && eleventy",
    "build:prod": "BUILD_TYPE=production npm run build && npm run html-minify",
    "build:neo": "HOST_TYPE=neocities BUILD_TYPE=production npm run build && npm run html-minify",
    "build:neko": "HOST_TYPE=nekoweb BUILD_TYPE=production npm run build && npm run html-minify",
    "debug": "DEBUG=Eleventy* eleventy --serve --watch"
  },
  "keywords": [],
  "author": "reduxflakes",
  "license": "GPL-2.0-only",
  "dependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10",
    "@11ty/eleventy-img": "7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@grimlink/eleventy-plugin-lucide-icons": "^2.2.3",
    "@sindresorhus/slugify": "^3.0.0",
    "@uncenter/eleventy-plugin-toc": "^2.1.2",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.4",
    "eleventy-plugin-time-to-read": "^1.3.0",
    "eleventy-plugin-vento": "^7.0.2",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-footnote": "^4.0.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-load-config": "^6.0.1",
    "slug": "^12.0.1"
  }
}
